# Salin file ini menjadi `backend/.env` untuk dev lokal di luar Docker,
# atau gunakan sebagai referensi nilai env yang harus diisi di VPS
# (Compose `environment:` atau k8s Secret `sapa-backend-secret`).

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/sapa_db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sapa
MONGODB_COLLECTION_ATTENDANCE=attendance_logs
MONGODB_COLLECTION_AUDIT=audit_logs

# --- Auth ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production
# Generate with: openssl rand -hex 24
EDGE_INGEST_KEY=change-me-in-production

# --- Seed (production) ---
# Set SAPA_RUN_SEED=1 ONLY for the very first deploy. After bootstrap, leave
# unset so admin/manager passwords survive container restarts.
SAPA_RUN_SEED=0
SAPA_ADMIN_PASSWORD=
SAPA_MANAGER_PASSWORD=

# --- CORS ---
# Comma-separated. Set to your prod hostname; "*" disables credentials.
CORS_ALLOW_ORIGINS=https://sapa.farhn.dev

# --- MQTT ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_GATE=sapa/gate
MQTT_TOPIC_ATTENDANCE=sapa/attendance
MQTT_TOPIC_DEVICE_STATUS=sapa/device/status
MQTT_TOPIC_DEVICE_HEARTBEAT=sapa/device/heartbeat
MQTT_TOPIC_PIR=sapa/pir
IOT_OFFLINE_AFTER_SECONDS=15
