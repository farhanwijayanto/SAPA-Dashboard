# =============================================================================
# SAPA Edge Server config — copy ke edge_server/.env lalu isi nilainya
# =============================================================================

# --- VPS Backend ---
# WAJIB pakai /api di belakang untuk produksi (ingress route /api -> backend).
SAPA_API_BASE=https://sapa.farhn.dev/api

# Auto-login: edge server login sebagai manager untuk GET /employees/
# (dipakai saat sync foto). Isi password manager Anda.
SAPA_USERNAME=manager
SAPA_PASSWORD=

# JWT manual (opsional). Kalau diisi, dipakai langsung tanpa auto-login.
# Biarkan kosong kalau pakai SAPA_USERNAME/SAPA_PASSWORD.
SAPA_API_TOKEN=

# Kunci mesin-ke-mesin. Ambil dari VPS:
#   kubectl -n sapa get secret sapa-backend-secret \
#     -o jsonpath='{.data.EDGE_INGEST_KEY}' | base64 -d
EDGE_INGEST_KEY=

# --- MQTT (untuk heartbeat gate online) ---
MQTT_BROKER=sapa.farhn.dev
MQTT_PORT=31883
MQTT_USERNAME=edge
MQTT_PASSWORD=
MQTT_TOPIC_GATE=sapa/gate
MQTT_TOPIC_HEARTBEAT=sapa/device/heartbeat
MQTT_TOPIC_PIR=sapa/pir

# --- Webcam + Recognition ---
CAMERA_INDEX=0
RECOGNITION_THRESHOLD=0.55
COOLDOWN_SECONDS=5
SYNC_EVERY_SECONDS=60
FRAME_PUSH_FPS=2

# --- Liveness anti-spoof (deteksi wajah asli vs foto/layar HP) ---
# LIVENESS_ENABLED=true  -> tolak wajah dari foto/layar HP/laptop
# LIVENESS_THRESHOLD     -> 0..1, makin tinggi makin ketat (default 0.5)
# LIVENESS_REQUIRE_BLINK -> true = WAJIB kedip untuk lolos (paling ketat,
#                            anti foto diam; default false agartidak ribet)
LIVENESS_ENABLED=true
LIVENESS_THRESHOLD=0.5
LIVENESS_REQUIRE_BLINK=false

# --- Auto-buka browser ke halaman /edge saat service start ---
# OPEN_BROWSER=true -> otomatis buka https://sapa.farhn.dev/edge di browser
# EDGE_PAGE_URL     -> override URL (default diturunkan dari SAPA_API_BASE)
OPEN_BROWSER=true
EDGE_PAGE_URL=
