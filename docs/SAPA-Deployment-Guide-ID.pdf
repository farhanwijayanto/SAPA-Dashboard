T*
(After=network.target) Tj
T*
() Tj
T*
([Service]) Tj
T*
(Type=simple) Tj
T*
(User=deploy) Tj
T*
(Group=deploy) Tj
T*
(WorkingDirectory=/opt/sapa) Tj
T*
(EnvironmentFile=/opt/sapa/backend/.env) Tj
T*
(ExecStart=/opt/sapa/backend/venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port) Tj
T*
(8080 --log-level info) Tj
T*
(Restart=always) Tj
T*
(RestartSec=2) Tj
T*
() Tj
T*
([Install]) Tj
T*
(WantedBy=multi-user.target) Tj
T*
(```) Tj
T*
() Tj
T*
(Lalu jalankan:) Tj
T*
(- `sudo systemctl daemon-reload`) Tj
T*
(- `sudo systemctl enable --now sapa-backend`) Tj
T*
(- `sudo journalctl -u sapa-backend -f`) Tj
T*
() Tj
